{
  "name": "feishu-llm-bot",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "up": "docker compose up -d --build",
    "down": "docker compose down",
    "logs": "docker compose logs -f --tail=100",
    "restart": "docker compose restart",
    "dev": "tsx src/index.ts",
    "selftest": "docker compose exec bot npx tsx src/selftest.ts",
    "trace": "tsx src/trace-cli.ts",
    "dev:bot": "tsx src/dev.ts"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "1.74.0",
    "@opencode-ai/sdk": "1.18.32",
    "dotenv": "18.0.6"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "4.23.15",
    "typescript": "^5.9.0"
  }
}
